{
  "name": "sahikara-observer",
  "version": "0.1.0",
  "description": "SAHIKARA Phase 1C — Read-Only On-Chain Market Observation Engine (Base)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "observe": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:security": "node scripts/security-scan.mjs"
  },
  "dependencies": {
    "@uniswap/sdk-core": "^5.8.0",
    "@uniswap/v3-sdk": "^3.13.0",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
