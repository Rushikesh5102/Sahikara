{
  "name": "sahikara-observer",
  "version": "0.1.0",
  "description": "SAHIKARA Phase 1C — Read-Only On-Chain Market Observation Engine (Base)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "observe": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" src/index.ts",
    "dev": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" watch src/index.ts",
    "test": "node --experimental-vm-modules \"node_modules/vitest/vitest.mjs\" run",
    "test:watch": "node --experimental-vm-modules \"node_modules/vitest/vitest.mjs\"",
    "typecheck": "node \"node_modules/typescript/bin/tsc\" --noEmit",
    "build": "node \"node_modules/typescript/bin/tsc\" --project tsconfig.build.json",
    "lint": "node \"node_modules/eslint/bin/eslint.js\" src tests --ext .ts",
    "lint:security": "node --experimental-vm-modules \"node_modules/vitest/vitest.mjs\" run tests/security.test.ts",
    "health": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" src/health.ts",
    "backup": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" src/backup.ts",
    "validate:1f": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" scripts/run-short-validation.ts",
    "validate:event": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" scripts/run-event-validation.ts",
    "simulate": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" scripts/run-phase3-simulation.ts",
    "shadow:validate": "node --experimental-vm-modules \"node_modules/tsx/dist/cli.mjs\" scripts/run-phase4-shadow.ts"
  },
  "dependencies": {
    "@uniswap/sdk-core": "^5.8.0",
    "@uniswap/v3-sdk": "^3.13.0",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^9.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
