# ============================================================
# SAHIKARA Observer — Environment Configuration Template
# ============================================================
#
# SECURITY NOTICE:
#   Copy this file to .env and fill in REAL values locally.
#   NEVER commit .env to Git. .gitignore blocks it.
#   NEVER paste real API keys or credentials into AI tools or chat.
#   These variables contain NO defaults for security-sensitive values.
#
# ============================================================

# ----------------------------------------------------------
# REQUIRED: Base RPC Configuration
# ----------------------------------------------------------

# HTTP JSON-RPC endpoint for Base mainnet (e.g., Alchemy, QuickNode, Infura)
# Obtain a free key at: https://www.alchemy.com/ or https://www.quicknode.com/
BASE_RPC_URL=
# WebSocket endpoint for Base mainnet (same provider as above)
# [ASSUMPTION] Alchemy Base WS format: wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# Optional for Phase 1C polling mode — leave blank to use HTTP polling only
BASE_WS_URL=

# Human-readable identifier for this RPC endpoint (logged with every observation)
# Example: alchemy-base-free-tier
RPC_ENDPOINT_ID=

# ----------------------------------------------------------
# OPTIONAL: Secondary RPC for cross-validation (Phase 2+)
# ----------------------------------------------------------

# Secondary Base HTTP endpoint (different provider for desync detection)
BASE_RPC_URL_SECONDARY=

# ----------------------------------------------------------
# Observation Configuration
# ----------------------------------------------------------

# Polling interval in milliseconds between full observation cycles
# [ASSUMPTION] Default: 30000 (30 seconds) — appropriate for Phase 1 research
# Do NOT set below 5000 to avoid rate-limiting on free RPC tiers
POLL_INTERVAL_MS=30000

# Comma-separated observation sizes in USD
# [NOTE] These are research observation sizes ONLY. No capital is deployed.
# Example: 1,5,10 (observe at $1, $5, and $10)
OBSERVATION_SIZES_USD=1,5,10

# INR/USD conversion rate (informational only, used for logging INR equivalents)
# [ASSUMPTION] Set this to the current approximate market rate
# Example: 83.50 (meaning 1 USD = ₹83.50)
INR_USD_RATE=83.50

# ----------------------------------------------------------
# Storage Configuration
# ----------------------------------------------------------

# Path to the SQLite observation database file
# [ASSUMPTION] Default: ./data/observations.db (relative to scanner/ directory)
DB_PATH=./data/observations.db

# ----------------------------------------------------------
# Risk Buffer Configuration (used in net profit calculation only)
# [ASSUMPTION] All values are PROVISIONAL per RISK_POLICY.md
# ----------------------------------------------------------

# Risk buffer percentage to deduct from gross profit (as a decimal)
# [ASSUMPTION] Default: 0.001 (0.1% of input capital)
RISK_BUFFER_FRACTION=0.001

# Minimum net expected profit threshold in USD below which opportunities are REJECTED
# [ASSUMPTION] Default: 0.05 (matches RISK_POLICY.md provisional minimum of $0.05)
MIN_NET_PROFIT_USD=0.05

# ----------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
